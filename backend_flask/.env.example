# Database Configuration
DB_ENGINE=sqlite # Use 'mysql' or 'sqlite'
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=attendance_app
MYSQL_PORT=3306

# Allowed Campus Location for Geofencing
ALLOWED_LATITUDE=20.2961
ALLOWED_LONGITUDE=85.8245
ALLOWED_RADIUS_KM=0.1 # 100 meters

# Server Config
PORT=5000
SECRET_KEY=attendance_secret_key_change_in_production
